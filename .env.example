# Browser-visible Firebase web configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Demo only: VITE_ values are public in the built application.
VITE_TMDB_ACCESS_TOKEN=
# For production, set this to a trusted backend that attaches the TMDB token.
# Omit VITE_TMDB_ACCESS_TOKEN when using such a backend.
VITE_TMDB_API_BASE_URL=https://api.themoviedb.org
